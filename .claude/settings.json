{
  "$note": "Research Agent 프로젝트 공유 설정. git 추적되어 clone한 모든 사용자에게 자동 적용. (1) hooks: activity.log 자동 기록. (2) permissions: 이 프로젝트에서 자주 쓰는 안전한 명령 사전 승인 — 매번 prompt 뜨지 않음. 위험한 명령(rm -rf, force push, hard reset 등)은 deny 목록으로 의도적 차단.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/activity_log_async.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/scripts/activity_log_async.sh\" on-prompt-submit 2>/dev/null; exit 0",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/activity_log_async.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/scripts/activity_log_async.sh\" on-turn-end 2>/dev/null; exit 0",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/activity_log_async.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/scripts/activity_log_async.sh\" on-bash-event 2>/dev/null; exit 0",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "$defaultMode_note": "사용자 요청으로 활성화됨 (2026-04-23). 'claude --dangerously-skip-permissions'과 동일 효과. deny 목록의 위험 명령은 여전히 차단됨. 조직 레벨에서 비활성화하려면 managed settings에서 disableBypassPermissionsMode: 'disable'.",
    "allow": [
      "Bash(python3 scripts/*)",
      "Bash(python3 $CLAUDE_PROJECT_DIR/scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(bash $CLAUDE_PROJECT_DIR/scripts/*)",
      "Bash(bash install.sh*)",
      "Bash(chmod +x *)",
      "Bash(chmod 644 *)",
      "Bash(chmod 755 *)",
      "Bash(git add *)",
      "Bash(git add -A*)",
      "Bash(git commit *)",
      "Bash(git commit -m *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git ls-files*)",
      "Bash(claude mcp *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(mkdir -p *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(find projects -*)",
      "Bash(find skills -*)",
      "Bash(find scripts -*)",
      "Bash(find docs -*)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(command -v *)",
      "Bash(which *)",
      "Bash(npm install -g @anthropic-ai/claude-code*)",
      "Bash(pip3 install *)",
      "mcp__consensus__search",
      "mcp__consensus__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r /*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -*)"
    ]
  }
}
